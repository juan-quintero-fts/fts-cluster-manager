APP_NAME=FTS Cluster Manager
APP_ENV=production
APP_SECRET=change-me

# Usuario para monitoreo y consultas de solo lectura.
SSH_USER=ftsuser
SSH_PORT=22
# Si SSH_PASSWORD tiene valor, se usa contraseña. Si está vacío, se usa esta llave.
SSH_KEY_PATH=/run/secrets/ssh_key
SSH_PASSWORD=

# Usuario privilegiado. NO se configura contraseña: la interfaz la pide en cada operación.
ROOT_SSH_USER=root

# Credenciales para consultar estado Galera desde el usuario operativo.
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_GRASTATE=/ftscluster/mysql/grastate.dat

NODES=172.16.0.1,172.16.0.2,172.16.0.3
EXPECTED_CLUSTER_SIZE=3

# Monitoreo: SOLO LECTURA. Nunca ejecuta acciones correctivas.
AUTO_MONITOR=true
MONITOR_INTERVAL=10

# ----------------------------------------------------------
# MongoDB Replica Set (mongosh se ejecuta remotamente por SSH)
# ----------------------------------------------------------
MONGO_ENABLED=true
MONGO_REPLICA_SET=rs0
MONGO_NODES=mongodb1=172.16.0.6:27017,mongodb2=172.16.0.7:27017,mongodb3=172.16.0.8:27017
MONGO_EXTERNAL_NODES=mongodb1=192.168.70.135:27017,mongodb2=192.168.70.160:27017,mongodb3=192.168.70.176:27017
MONGO_DATABASE=easyroad
MONGO_SERVICE=mongod
MONGO_MONITOR_INTERVAL=10
# Preparado para autenticación futura; no se activa automáticamente.
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
# Opcionales; usan SSH_USER, SSH_PORT y SSH_KEY_PATH como fallback.
MONGO_SSH_USER=
MONGO_SSH_PORT=
MONGO_SSH_KEY_PATH=
